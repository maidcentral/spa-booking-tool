{
  "mcpServers": {
    "figma": {
      "command": "npx",
      "args": [
        "-y",
        "@figma/mcp-server-figma"
      ],
      "env": {
        "FIGMA_PERSONAL_ACCESS_TOKEN": "${FIGMA_PERSONAL_ACCESS_TOKEN}"
      },
      "description": "UI/UX design integration with Figma - converts designs to Next.js components"
    },
    "browser": {
      "command": "npx",
      "args": [
        "-y",
        "@automator/mcp-server-playwright"
      ],
      "description": "Browser automation for UI testing and component verification"
    },
    "prompt-optimizer": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-server-prompt-optimizer"
      ],
      "env": {
        "ANTHROPIC_API_KEY": "${ANTHROPIC_API_KEY}"
      },
      "description": "Optimizes and enhances prompts before execution"
    },
    "web-research": {
      "command": "npx",
      "args": [
        "-y",
        "@automator/mcp-server-web-researcher"
      ],
      "description": "Research current UI/UX trends and Metronic documentation"
    },
    "git": {
      "command": "npx",
      "args": [
        "-y",
        "@git/mcp-server-git"
      ],
      "description": "Git operations for workflow automation"
    }
  },
  "globalEnvironment": {
    "UI_FRAMEWORK": "next-metronic",
    "DESIGN_SYSTEM": "metronic-v9",
    "AUTO_OPTIMIZE_PROMPTS": "true"
  }
}