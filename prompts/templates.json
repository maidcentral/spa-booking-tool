{
  "component_creation": {
    "base": "Create a {component_type} component in {file_path} using Next.js 15, TypeScript, and Tailwind CSS v4",
    "enhancements": [
      "Follow Metronic design patterns",
      "Include proper TypeScript types",
      "Add loading and error states",
      "Implement responsive design (mobile-first)",
      "Include ARIA labels for accessibility",
      "Use existing components from /app/components where applicable"
    ],
    "required_context": [
      "component_type",
      "file_path",
      "props_interface",
      "styling_requirements"
    ]
  },
  
