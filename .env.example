# -----------------------------------------------------------------------------
# MaidCentral Booking Tool — environment configuration
#
# Copy this file to `.env.local` and fill in the values for your deployment.
# Never commit `.env.local` — it contains tenant credentials.
# -----------------------------------------------------------------------------


# =============================================================================
# REQUIRED — the app throws at startup if these are unset
# =============================================================================

# MaidCentral API host (no trailing slash). The entire booking flow — token
# fetch, scope/pricing/availability reads, and lead/quote/book writes — goes
# through this base URL.
#   Production: https://api.maidcentral.com
#   Sandbox:    https://api-sandbox.maidcentral.com (example)
NEXT_PUBLIC_API_BASE_URL=https://api.maidcentral.com

# Server-only credentials used by `app/api/auth/route.ts` to exchange the
# MaidCentral API user for a short-lived access token. The token is returned to
# the browser; the username/key never leave the server. Provision one API user
# per branch from the MaidCentral admin → Users → assign the `Api` role.
API_USERNAME=
API_KEY=


# =============================================================================
# PAYMENT — CardConnect
# =============================================================================

# Defaults to `uat` so a fresh clone cannot accidentally charge real cards.
# Flip to `production` only for live environments.
#   uat         → https://fts-uat.cardconnect.com (test cards, no charges)
#   production  → https://fts.cardconnect.com (real charges)
NEXT_PUBLIC_CARDCONNECT_ENV=uat


# =============================================================================
# COMPLIANCE LINKS (optional)
#
# Rendered below the SMS consent checkboxes on Step 1. If both are unset the
# whole "By continuing you agree to…" sentence is hidden. If only one is set
# only that link renders. Both should be absolute URLs opening in a new tab.
# =============================================================================

NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_PRIVACY_URL=


# =============================================================================
# FEATURE FLAGS (optional)
# =============================================================================

# Chooses between the 3-step wizard and the single-page continuous scroll.
# Accepts true/1/yes/on or false/0/no/off (case-insensitive). Default: false.
NEXT_PUBLIC_MULTI_STEP_LAYOUT=true

# Shows a "Promo code" input on Step 3. The Lead API has no discount-code
# validation endpoint yet (see docs/online-booking-form/03-gap-analysis.md §2)
# so the stub rejects every code — surface the field only if your UX wants
# the teaser before the real endpoint ships.
NEXT_PUBLIC_ENABLE_DISCOUNT_CODES=false

# Disables API calls in favor of local mocks. Intended for Storybook / isolated
# component dev only. Leave off in any deployed environment.
NEXT_PUBLIC_API_MOCKING_ENABLED=false


# =============================================================================
# ATTRIBUTION (optional)
# =============================================================================

# Forwarded to MaidCentral for internal reporting. Typically the Partner
# company's shortcode or account identifier.
NEXT_PUBLIC_PARTNER_ID=


# =============================================================================
# LEGACY PROXY — the multi-step flow no longer uses this, but it's referenced
# by the old `app/api/lead/create-or-update/route.ts` server proxy that some
# deployments still route through. Leave blank if you only use the multi-step
# or single-page client flows (both hit the Lead API directly via the token
# returned from /api/auth).
# =============================================================================

MAIDCENTRAL_USERNAME=
MAIDCENTRAL_PASSWORD=
MAIDCENTRAL_PHONE_CODE=


# =============================================================================
# CLIENT-SIDE ANALYTICS (no env var — documented here for discoverability)
#
# The booking widget emits typed events through an optional window hook.
# Partners opt in by assigning the handler in their host page before the
# widget mounts:
#
#   <script>
#     window.mcBookingTrack = function (event) {
#       // event is one of:
#       //   { type: "booking_started" }
#       //   { type: "booking_step_completed", step, durationMs }
#       //   { type: "booking_price_recalculated", firstJobTotal, recurringTotal, totalHours }
#       //   { type: "booking_completed", quoteId, leadId }
#       //   { type: "booking_error", step, message }
#       // Forward to Segment / GA / Rudderstack / whatever.
#     };
#   </script>
#
# If no handler is set, tracking is a no-op. Handler errors are swallowed so
# a broken analytics hook can never break the booking form.
# =============================================================================
